<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 10+: with three-button navigation the system adds its own white or black
    contrast scrim behind a transparent navigation bar. Turn it off and tint the bar
    with the app background instead, slightly translucent. Android 15+ ignores the
    bar color (edge-to-edge is enforced) but still honors the contrast setting.
-->
<resources>
    <style name="Theme.Softring" parent="Base.Theme.Softring">
        <item name="android:navigationBarColor">@color/nav_bar_tint</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
